{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": ["error", { "patterns": [
      { "group": ["@/core-algorithm/*/**"], "message": "Import a core-algorithm module through its index.ts." },
      { "group": ["@/features/*/**"], "message": "Import a feature through its index.ts." }
    ] }]
  },
  "overrides": [
    {
      "files": ["src/core-algorithm/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@/core-algorithm/*/**", "../*/**"], "message": "Import a core-algorithm module through its index.ts." },
          { "group": ["@/features", "@/features/**", "../../**"], "message": "core-algorithm must not depend on features." },
          { "group": ["react", "react/*", "react-dom", "react-dom/*"], "message": "core-algorithm is plain TS: no React." }
        ] }]
      }
    },
    {
      "files": ["src/features/*/ui/**", "src/features/*/state/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@/core-algorithm/*/**"], "message": "Import a core-algorithm module through its index.ts." },
          { "group": ["@/features", "@/features/**", "../../**"], "message": "Features must not import each other; use ../logic for this feature's own logic." },
          { "group": ["../logic/**"], "message": "Import this feature's logic through ../logic (its index.ts)." }
        ] }]
      }
    },
    {
      "files": ["src/features/*/logic/**"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [
          { "group": ["@/core-algorithm/*/**"], "message": "Import a core-algorithm module through its index.ts." },
          { "group": ["@/features", "@/features/**", "../../**", "../ui", "../ui/**"], "message": "logic must not import ui or another feature." },
          { "group": ["react", "react/*", "react-dom", "react-dom/*"], "message": "logic is plain TS: no React." }
        ] }]
      }
    }
  ]
}
